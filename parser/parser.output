Grammar

    0 $accept: input $end

    1 input: statement ';'

    2 statement: use_stmt
    3          | select_stmt
    4          | insert_stmt
    5          | update_stmt
    6          | delete_stmt
    7          | create_db_stmt
    8          | drop_db_stmt
    9          | create_table_stmt
   10          | drop_table_stmt

   11 use_stmt: TOK_USE TOK_IDENT

   12 create_db_stmt: TOK_CREATE TOK_DATABASE TOK_IDENT

   13 drop_db_stmt: TOK_DROP TOK_DATABASE TOK_IDENT

   14 create_table_stmt: TOK_CREATE TOK_TABLE TOK_IDENT '(' column_def_list ')'

   15 drop_table_stmt: TOK_DROP TOK_TABLE TOK_IDENT

   16 column_def_list: column_def
   17                | column_def_list ',' column_def

   18 column_def: TOK_IDENT data_type opt_primary_key opt_nullable

   19 data_type: TOK_INT
   20          | TOK_BIGINT
   21          | TOK_VARCHAR
   22          | TOK_TEXT
   23          | TOK_BOOLEAN

   24 opt_primary_key: ε
   25                | TOK_PRIMARY TOK_KEY

   26 opt_nullable: ε
   27             | TOK_NOT TOK_NULL
   28             | TOK_NULL

   29 select_stmt: TOK_SELECT select_list TOK_FROM TOK_IDENT opt_where opt_order_by opt_limit

   30 select_list: '*'
   31            | column_name_list

   32 column_name_list: TOK_IDENT
   33                 | column_name_list ',' TOK_IDENT

   34 insert_stmt: TOK_INSERT TOK_INTO TOK_IDENT insert_columns TOK_VALUES insert_values

   35 insert_columns: ε
   36               | '(' column_name_list ')'

   37 insert_values: '(' value_item_list ')'

   38 in_values: '(' value_item_list ')'

   39 value_item_list: value_item
   40                | value_item_list ',' value_item

   41 value_item: TOK_NUMBER
   42           | TOK_STRING

   43 update_stmt: TOK_UPDATE TOK_IDENT TOK_SET assignment_list opt_where

   44 assignment_list: assignment
   45                | assignment_list ',' assignment

   46 assignment: TOK_IDENT TOK_EQ value_item

   47 delete_stmt: TOK_DELETE TOK_FROM TOK_IDENT opt_where

   48 opt_where: ε
   49          | TOK_WHERE condition_expr

   50 condition_expr: condition_term
   51               | condition_expr TOK_OR condition_term

   52 condition_term: condition_factor
   53               | condition_term TOK_AND condition_factor

   54 condition_factor: TOK_IDENT compare_op value_item
   55                 | TOK_IDENT TOK_IN in_values
   56                 | TOK_IDENT TOK_NOT TOK_IN in_values
   57                 | TOK_IDENT TOK_LIKE TOK_STRING
   58                 | TOK_IDENT TOK_NOT TOK_LIKE TOK_STRING
   59                 | TOK_IDENT TOK_IS TOK_NULL
   60                 | TOK_IDENT TOK_IS TOK_NOT TOK_NULL
   61                 | '(' condition_expr ')'
   62                 | TOK_NOT condition_factor

   63 compare_op: TOK_EQ
   64           | TOK_NE
   65           | TOK_GT
   66           | TOK_GE
   67           | TOK_LT
   68           | TOK_LE

   69 opt_order_by: ε
   70             | TOK_ORDER TOK_BY order_item

   71 order_item: TOK_IDENT
   72           | TOK_IDENT order_direction

   73 order_direction: TOK_ASC
   74                | TOK_DESC

   75 opt_limit: ε
   76          | TOK_LIMIT TOK_NUMBER
   77          | TOK_LIMIT TOK_NUMBER TOK_OFFSET TOK_NUMBER
   78          | TOK_LIMIT TOK_NUMBER ',' TOK_NUMBER


