Grammar

    0 $accept: input $end

    1 input: statement ';'

    2 statement: use_stmt
    3          | select_stmt
    4          | insert_stmt
    5          | update_stmt
    6          | delete_stmt

    7 use_stmt: TOK_USE TOK_IDENT

    8 select_stmt: TOK_SELECT select_list TOK_FROM TOK_IDENT opt_where

    9 select_list: '*'
   10            | column_name_list

   11 insert_stmt: TOK_INSERT TOK_INTO TOK_IDENT column_list TOK_VALUES value_list

   12 update_stmt: TOK_UPDATE TOK_IDENT TOK_SET assignment_list opt_where

   13 delete_stmt: TOK_DELETE TOK_FROM TOK_IDENT opt_where

   14 opt_where: ε
   15          | TOK_WHERE condition_expr

   16 condition_expr: condition_term
   17               | condition_expr TOK_OR condition_term

   18 condition_term: condition_factor
   19               | condition_term TOK_AND condition_factor

   20 condition_factor: TOK_IDENT '=' TOK_NUMBER
   21                 | TOK_IDENT '>' TOK_NUMBER
   22                 | TOK_IDENT '<' TOK_NUMBER
   23                 | TOK_IDENT TOK_GE TOK_NUMBER
   24                 | TOK_IDENT TOK_LE TOK_NUMBER
   25                 | TOK_IDENT '=' TOK_STRING
   26                 | '(' condition_expr ')'

   27 column_name_list: TOK_IDENT
   28                 | column_name_list ',' TOK_IDENT

   29 column_list: '(' column_name_list ')'

   30 value_list: '(' value_item_list ')'

   31 value_item_list: value_item
   32                | value_item_list ',' value_item

   33 value_item: TOK_NUMBER
   34           | TOK_STRING

   35 assignment_list: assignment
   36                | assignment_list ',' assignment

   37 assignment: TOK_IDENT '=' TOK_NUMBER
   38           | TOK_IDENT '=' TOK_STRING


